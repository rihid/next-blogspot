# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# generated search index
/public/pagefind

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local tooling (not part of the product)
.omo/
.codegraph

# generated scaffolder template (produced at pack time)
/packages/create-next-blogspot/template/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
