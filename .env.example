# ---------------------------------------------------------------------------
# next-blogspot environment
# Copy to `.env.local` and fill in. Only BLOG_URL is required.
# ---------------------------------------------------------------------------

# Required. Your blog URL, either a custom domain or a *.blogspot.com host.
BLOG_URL="https://example.blogspot.com"

# Required in production. Public origin of the deployed frontend, used for
# canonical URLs, the sitemap and the RSS feed. Never the Blogger origin.
NEXT_PUBLIC_SITE_URL="https://example.com"

# Optional. Numeric Blogger blog ID. Resolved from BLOG_URL when omitted.
BLOGGER_BLOG_ID=""

# Optional. Enables the Blogger API v3 data mode (pages, richer image metadata,
# higher pagination caps). Create a key in Google Cloud Console with the
# "Blogger API v3" enabled.
BLOGGER_API_KEY=""

# Required for on-demand revalidation. Generate with: openssl rand -hex 32
REVALIDATE_SECRET=""

# Optional. ISR fallback TTL in seconds. Defaults to 3600.
REVALIDATE_TTL="3600"

# Optional. How many of the newest posts to prerender at build time. The rest
# render on demand and are cached by ISR. Defaults to 25.
PRERENDER_POST_LIMIT="25"

# Optional. Giscus comments (new comments). Get these values from https://giscus.app
NEXT_PUBLIC_GISCUS_REPO=""
NEXT_PUBLIC_GISCUS_REPO_ID=""
NEXT_PUBLIC_GISCUS_CATEGORY=""
NEXT_PUBLIC_GISCUS_CATEGORY_ID=""

# Optional. Public repository, linked from the Documentation card on the home page.
NEXT_PUBLIC_REPOSITORY_URL="https://github.com/rihid/next-blogspot"
